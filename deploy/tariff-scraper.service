# /etc/systemd/system/tariff-scraper.service
# tariff-scrape 单次抓取单元, 由 tariff-scraper.timer 定时触发
[Unit]
Description=中国移动资费公示抓取 (tariff-scrape)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 专用低权用户(由 install-debian12.sh 创建)
User=tariff
Group=tariff
WorkingDirectory=/opt/tariff-scraper
# 省份列表在 /etc/tariff-scraper.conf 里配置(TARIFF_PROVINCES)
EnvironmentFile=-/etc/tariff-scraper.conf
ExecStart=/usr/bin/node /opt/tariff-scrape/tariff-query.js --out /var/lib/tariff-scraper/report.txt --json
# 失败时 5 分钟后自动补跑(脚本内部还有 1 次即时重试)
Restart=on-failure
RestartSec=300
# 限制重启频率: 1 小时内最多 3 次, 超限进入 failed 不再重试。
# 防止"看门狗/内存超限杀掉 + on-failure 重启"级联成无限循环
StartLimitIntervalSec=3600
StartLimitBurst=3
# 含重试整体不应超过 25 分钟, 超时强杀, 防止挂死占住槽位
RuntimeMaxSec=1500
# 资源约束: 后台抓取任务不与同机其他服务抢资源
Nice=15
CPUWeight=30
MemoryMax=1G
IOSchedulingClass=idle
# 沙箱加固; 脚本已把 Chrome user-data-dir 指向临时目录, 配合 PrivateTmp 可写
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tariff-scraper
StateDirectory=tariff-scraper

[Install]
WantedBy=multi-user.target
